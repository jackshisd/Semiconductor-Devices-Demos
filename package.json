{
  "name": "semiconductor-physics-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/sync-export.mjs && npm run check:export",
    "test": "node --experimental-strip-types --test lib/physics.test.mjs lib/breakdown.test.mjs lib/lectures.test.mjs lib/lecture-models.test.mjs lib/scattering.test.mjs lib/lecture-three.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:export": "node --experimental-strip-types scripts/check-export.mjs",
    "slides:sync": "node scripts/sync-slides.mjs",
    "predev": "npm run slides:sync",
    "prebuild": "npm run slides:sync"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
